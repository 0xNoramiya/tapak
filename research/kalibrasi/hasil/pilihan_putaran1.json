{
  "aturan": {
    "1_tanpa_tuduhan_salah": "tidak ada tuduhan salah di pelacakan dev mana pun (salinan, koalisi jujur, induk tanpa tanda)",
    "2_tanpa_putusan_hilang": "setiap salinan dev yang disebut dekoder sekarang tetap disebut, dan setiap koalisi dev tidak kehilangan anggota yang disebut (tahap mana pun)",
    "3_tanpa_peringatan_baru": "tidak ada pelacakan jujur dev (salinan, koalisi jujur, induk tanpa tanda) tanpa peringatan dengan dekoder sekarang yang mendapat peringatan (pola penghapusan, bacaan jelas tanpa nama, atau pola tanda terbalik) dengan kandidat",
    "4_kalibrasi": "bobot pola latar salinan dev, per kelas medium (pdf; png, pesan, kecil x 28-48, 56-84, 96-150 dpi; layar_sim; foto; ponsel; monitor; cetak) dan kelompok bobot W_EDGES: dengan n bit, k salah, dan E = jumlah 1 / (1 + exp |L|), P(Poisson(E) >= k) >= 1e-4 (tidak terlalu yakin secara bermakna)",
    "5_pilihan": "di antara kandidat yang lolos 1 sampai 4, galat kalibrasi terkecil: rata-rata atas kelas medium dari jumlah |k - E| atas kelompok bobot dibagi jumlah bit kelas itu; seri: lebih banyak putusan benar, lalu median skor salinan / Z lebih besar; tidak ada yang lolos: dekoder tetap kejenuhan",
    "level_poisson": 0.0001
  },
